// Generated by `vinext init`. `vinext build` resolves this into
// dist/server/wrangler.json, and that resolved file is what deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedex-web",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  // Hostnames are attached in the Cloudflare dashboard, next to the DNS they
  // depend on, so the deploy token needs no zone access and no real domain is
  // written here. workers.dev stays off, so the sprites have one address:
  // the one the other apps are given.
  "workers_dev": false,
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}
