# `moon run supabase:status` prints these. The publishable key is the fixed
# local-development key and is safe to commit.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Production only: lets example.com see a session set on account.example.com.
# Unset locally — both apps are on localhost and cookies ignore the port.
# In deploys this comes from the GitHub `production` environment, not this file.
# NEXT_PUBLIC_COOKIE_DOMAIN=.example.com

# Where every app lives, for the app drawer. Inlined at build time.
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001
NEXT_PUBLIC_POKEDEX_URL=http://localhost:3003
NEXT_PUBLIC_CODER_URL=http://localhost:3002
