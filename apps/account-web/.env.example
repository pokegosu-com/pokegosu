# Production only: lets example.com see a session set on account.example.com.
# Unset locally — both apps are on localhost and cookies ignore the port.
# In deploys this comes from the GitHub `production` environment, not this file.
# NEXT_PUBLIC_COOKIE_DOMAIN=.example.com
