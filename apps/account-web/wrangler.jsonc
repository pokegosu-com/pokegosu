// Generated by `vinext init`, then given a route. `vinext build` resolves this
// into dist/server/wrangler.json, and that resolved file is what deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "account-web",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  // Declared here rather than attached in the dashboard, so the hostname a
  // deploy serves is reviewable and cannot drift. Asserting it needs the API
  // token to reach the zone, not just Workers.
  "routes": [{ "pattern": "account.pokegosu.com", "custom_domain": true }],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}
